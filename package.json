{
  "name": "tome",
  "productName": "Tome",
  "version": "0.8.1",
  "description": "A controller-first PDF reader for Steam Deck Game Mode",
  "private": true,
  "license": "UNLICENSED",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "fixtures": "electron scripts/make-fixtures.mjs",
    "dev:fixtures": "TOME_LIBRARY_DIRS=fixtures/pdfs TOME_DATA_DIR=.tome-dev electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --x64",
    "dist:mac": "electron-vite build && electron-builder --mac dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
